# ─── Raseel configuration ───────────────────────────────────────────────
# Copy to .env and fill in, or run ./scripts/install.sh to generate it.

# Public domain pointing at this server (A record). Caddy gets HTTPS for it automatically.
DOMAIN=inbox.example.com

# Image version to run. Use a release tag (e.g. 1.0.0) in production.
RASEEL_VERSION=latest

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# 32-byte key that encrypts WhatsApp tokens and API keys at rest.
# Generate with: openssl rand -base64 32
# Back it up: without it, stored secrets cannot be decrypted.
ENCRYPTION_KEY=

# Secret for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: SMTP for invitation emails, e.g. smtp://user:password@smtp.example.com:587
# Without it, Raseel shows an invitation link you can share yourself.
SMTP_URL=
MAIL_FROM=Raseel <no-reply@example.com>

LOG_LEVEL=info
